{
  "created": "2026-09-11",
  "description": "Main harness for PiqoBot S400 4-axis SCARA robot. Covers cabinet-to-arm power distribution and CAN drive bus.",
  "display_rules": [
    {
      "color": "#000000",
      "match": {
        "net_class": "ground"
      },
      "width_px": 2
    },
    {
      "color": "#dc2626",
      "match": {
        "net_class": "power"
      },
      "width_px": 4
    },
    {
      "match": {
        "tag": {
          "placement": "external"
        }
      },
      "style": "dashed"
    },
    {
      "color": "#0891b2",
      "match": {
        "bus_ref": "bus_can0"
      },
      "width_px": 3
    }
  ],
  "id": "proj_PIQOBOT_S400",
  "name": "PiqoBot S400 SCARA Harness",
  "rule_config": {
    "ambient_c": 30.0,
    "ampacity_standard": "AUTOMOTIVE_PRACTICE",
    "inrush_factor": 1.0,
    "insulation_voltage_margin": 1.5,
    "power_headroom_threshold_pct": 80.0,
    "release_require_measured_lengths": false
  },
  "schema_version": 1,
